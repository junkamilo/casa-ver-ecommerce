# ── Integración POS -> Web (catálogo) ─────────────────────────────────────────
# Solo servidor: nunca usar el prefijo NEXT_PUBLIC_ para estas variables.
# Las credenciales las genera el administrador del POS con scripts/generar-clave-web.ps1.

# Base de la API pública del POS (sin barra final)
POS_API_BASE_URL=https://pos.example.com/api/public/catalog

# Clave de integración enviada en el encabezado X-Api-Key (cvw_...)
POS_API_KEY=

# Secreto compartido para verificar la firma HMAC de los avisos (webhook)
POS_WEBHOOK_SECRET=

# Promoción de bienvenida del POS (tipo EMAIL) que emite el cupón de primera compra. Opcional:
# por defecto PRM-WELCOME-10, la que crea la migración V107 del POS.
POS_WELCOME_PROMOTION_ID=
# Base pública de las fotos del POS (termina en /api). En desarrollo: http://localhost:8080/api
NEXT_PUBLIC_POS_MEDIA_BASE_URL=https://pos.casaverdeoficial.com/api

# ── Túnel ngrok (solo desarrollo: webhooks de Bold/Addi) ─────────────────────
# `npm run tunnel` usa este dominio fijo; si se omite, toma el host de NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_APP_URL, NEXTAUTH_URL, AUTH_URL y BOLD_CALLBACK_URL deben apuntar al mismo dominio.
# NGROK_DOMAIN=su-dominio.ngrok-free.dev
