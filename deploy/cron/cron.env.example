# Copiar a /etc/casa-verde/cron.env en el VPS (chmod 600, dueño el usuario de cron).
# CRON_SECRET debe ser EXACTAMENTE el de la web (.env del VPS). Vercel ya no lo envía: lo manda cv-cron.sh.
CRON_SECRET=
# Dirección donde responde la web en el VPS, sin barra final.
CV_APP_URL=http://127.0.0.1:3000
