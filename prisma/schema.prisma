generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS (Configuración Global)
// ============================================================

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  ACTIVE    // Visible en la tienda
  INACTIVE  // Oculto
  DRAFT     // Borrador
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  ONESIZE
}

enum OrderStatus {
  PENDING     // Creada, esperando pago
  PROCESSING  // Webhook recibido, validando
  PAID        // Pago confirmado
  SHIPPED     // En camino
  DELIVERED   // Entregado
  CANCELLED   // Cancelada
  FAILED      // Pago fallido
  REFUNDED    // Reembolsado por Bold (VOID_APPROVED)
}

enum PaymentMethod {
  BOLD
  ADDI
  NEQUI
  BANCOLOMBIA
  DAVIPLATA
}

// ============================================================
// AUTENTICACIÓN & USUARIOS (NextAuth + Perfil Cliente)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  recoveryEmail String?
  
  // Programa Early Bird: primeros 10 registros obtienen 10% de descuento permanente
  earlyBirdDiscount     Boolean   @default(false)
  earlyBirdDiscountAt   DateTime?

  // Relaciones
  accounts              Account[]
  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  verificationTokens    EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([expires])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([expires])
  @@map("password_reset_tokens")
}

// Registro pendiente de verificación — el usuario NO existe en `users` todavía.
// Se crea al solicitar registro y se elimina al verificar el correo exitosamente.
model PendingRegistration {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String
  phone         String?
  recoveryEmail String?
  codeHash      String
  expires       DateTime
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([expires])
  @@map("pending_registrations")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String
  cedula        String?
  phone         String
  department    String
  city          String
  address       String
  addressDetail String?
  zipCode       String?
  isDefault     Boolean  @default(false)

  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// CATÁLOGO DE PRODUCTOS
// ============================================================

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?    @db.Text     // Descripción visible en la página de colección
  image           String?                 // URL Cloudinary de portada
  order           Int        @default(0)  // Orden de aparición en menú y listados
  isActive        Boolean    @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Subcategorías (árbol recursivo)
  // parentId = null  →  categoría raíz (Ej: "Conjuntos", "Camisetas")
  // parentId = <id>  →  subcategoría   (Ej: "Conjuntos Mujer" hija de "Conjuntos")
  parentId        String?
  parent          Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  subcategories   Category[] @relation("CategoryToSubcategory")

  products        Product[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])   // Búsqueda rápida de subcategorías y categorías raíz
  @@index([isActive])   // Filtrar solo activas sin full-scan
  @@index([order])      // Ordenamiento eficiente en menú
  @@map("categories")
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String         @db.Text
  basePrice       Decimal        @db.Decimal(10, 2)
  comparePrice    Decimal?       @db.Decimal(10, 2) // Precio tachado (oferta)

  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])

  status          ProductStatus  @default(DRAFT)
  isFeatured      Boolean        @default(false)
  isNew           Boolean        @default(false)

  // Etiquetas de Producto (con control de tiempo)
  isProductNew    Boolean        @default(false)
  isProductNewAt  DateTime?      // Timestamp cuando se activó — expira automáticamente a los 7 días
  isOnSale        Boolean        @default(false)
  isOnSaleAt      DateTime?      // Timestamp cuando se activó la oferta

  // SEO
  metaTitle       String?
  metaDescription String?

  // Datos Adicionales
  videoUrl        String?
  
  // Calificaciones
  rating          Float          @default(0)
  numReviews      Int            @default(0)

  // Conjunto (Set) de piezas
  isSet           Boolean        @default(false)

  // Relaciones Clave
  images          ProductImage[] // Imágenes generales o por defecto
  colors          ProductColor[] // Definición de colores disponibles
  variants        ProductVariant[] // Inventario real (SKUs)
  items           ProductItem[]  // Solo cuando isSet=true
  subProducts     SubProduct[]   // Subproductos independientes (Ej. Short de un conjunto)
  reviews         Review[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("products")
}

// ============================================================
// VARIANTES & IMÁGENES (Lógica de Colores)
// ============================================================

model ProductColor {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String         // Ej: "Verde Militar"
  hexCode   String         // Ej: "#4B5320"

  // Las imágenes se atan al color. Si selecciono "Verde", cargo estas fotos.
  images    ProductImage[] 
  variants  ProductVariant[]

  @@unique([productId, name])
  @@map("product_colors")
}

model ProductImage {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  order     Int           @default(0)

  // Relación opcional: Si es null, es imagen general. Si tiene colorId, es específica.
  colorId   String?
  color     ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  colorId       String
  color         ProductColor       @relation(fields: [colorId], references: [id], onDelete: Cascade)

  size          Size
  sku           String             @unique // Identificador único de inventario
  priceOverride Decimal?           @db.Decimal(10, 2) // Opcional: Si la XXL vale más

  // Gestión de Inventario
  stock         Int                @default(0)
  minStock      Int                @default(2) // Alerta de stock bajo
  reserved      Int                @default(0) // Stock temporalmente en carritos

  isActive      Boolean            @default(true)

  reservations  StockReservation[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productId, colorId, size]) // Evita duplicados de la misma combinación
  @@map("product_variants")
}

// ============================================================
// CONJUNTOS (Sets) — Piezas de un producto compuesto
// ============================================================

model ProductItem {
  id        String             @id @default(cuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  name         String             // Ej: "Short", "Pantalón"
  description  String?            @db.Text
  price        Decimal?           @db.Decimal(10, 2) // Precio propio (opcional)
  comparePrice Decimal?           @db.Decimal(10, 2) // Precio tachado (oferta)
  videoUrl     String?
  order        Int                @default(0)

  colors    ProductItemColor[]

  createdAt DateTime           @default(now())

  @@index([productId])
  @@map("product_items")
}

model ProductItemColor {
  id      String               @id @default(cuid())
  itemId  String
  item    ProductItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  name    String               // Ej: "Verde Militar"
  hexCode String               // Ej: "#4B5320"

  images   ProductItemImage[]
  variants ProductItemVariant[]

  @@unique([itemId, name])
  @@map("product_item_colors")
}

model ProductItemImage {
  id      String           @id @default(cuid())
  colorId String
  color   ProductItemColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  url     String
  altText String?
  order   Int              @default(0)

  @@index([colorId])
  @@map("product_item_images")
}

model ProductItemVariant {
  id       String           @id @default(cuid())
  colorId  String
  color    ProductItemColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  size     Size
  sku      String           @unique
  stock    Int              @default(0)
  isActive Boolean          @default(true)

  @@unique([colorId, size])
  @@map("product_item_variants")
}

// ============================================================
// SUBPRODUCTOS — Piezas vendibles de forma independiente
// ============================================================

model SubProduct {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  name        String
  description String?           @db.Text
  price       Decimal?          @db.Decimal(10, 2)
  stock       Int               @default(0)
  videoUrl    String?
  order       Int               @default(0)

  colors      SubProductColor[]

  createdAt   DateTime          @default(now())

  @@index([productId])
  @@map("sub_products")
}

model SubProductColor {
  id           String              @id @default(cuid())
  subProductId String
  subProduct   SubProduct          @relation(fields: [subProductId], references: [id], onDelete: Cascade)

  name         String
  hexCode      String

  images       SubProductImage[]
  variants     SubProductVariant[]

  @@unique([subProductId, name])
  @@map("sub_product_colors")
}

model SubProductImage {
  id      String          @id @default(cuid())
  colorId String
  color   SubProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  url     String
  altText String?
  order   Int             @default(0)

  @@index([colorId])
  @@map("sub_product_images")
}

model SubProductVariant {
  id       String          @id @default(cuid())
  colorId  String
  color    SubProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  size     Size
  sku      String          @unique
  stock    Int             @default(0)
  isActive Boolean         @default(true)

  @@unique([colorId, size])
  @@map("sub_product_variants")
}

// ============================================================
// SISTEMA DE RESERVAS & PAGOS
// ============================================================

model StockReservation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int
  expiresAt DateTime       // Se libera automáticamente después de 15 min
  released  Boolean        @default(false)

  createdAt DateTime       @default(now())

  @@index([expiresAt])
  @@map("stock_reservations")
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique // Secuencial amigable "ORD-001"
  
  userId             String
  user               User          @relation(fields: [userId], references: [id])

  // Snapshot de Dirección (Para que no cambie si el usuario edita su perfil)
  addressId          String?
  address            Address?      @relation(fields: [addressId], references: [id])
  shippingName       String
  shippingAddress    String
  shippingCity       String
  shippingDepartment String
  shippingPhone      String

  // Montos
  subtotal                  Decimal       @db.Decimal(10, 2)
  shippingCost              Decimal       @db.Decimal(10, 2) @default(0)
  discount                  Decimal       @db.Decimal(10, 2) @default(0)
  total                     Decimal       @db.Decimal(10, 2)

  // Descuento Early Bird
  earlyBirdDiscountApplied  Boolean       @default(false)

  // Estado y Pago
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  
  // Bold / Addi Integración
  transactionId      String?       @unique // UUID idempotente enviado a pasarela
  boldLinkId         String?       // LNK_* retornado por Bold al crear el link de pago
  paymentId          String?       // transaction_id retornado por Bold en el webhook al aprobar

  // Logística
  trackingNumber     String?
  trackingUrl        String?

  items              OrderItem[]
  webhookLogs        WebhookLog[]
  notifications      AdminNotification[]

  paidAt             DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?

  // Email tracking
  confirmationEmailSentAt    DateTime?
  confirmationEmailFailedAt  DateTime?
  confirmationEmailError     String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String // Referencia al producto (sin FK para soportar sets)
  variantId   String // ProductVariant.id o ProductItemVariant.id

  // Snapshot del ítem (Nombre, precio, etc. congelados al momento de compra)
  name        String
  sku         String
  colorName   String
  size        Size
  price       Decimal        @db.Decimal(10, 2)
  quantity    Int
  total       Decimal        @db.Decimal(10, 2)
  imageUrl    String?        // Foto principal de la variante

  @@map("order_items")
}

// ============================================================
// RESEÑAS & CALIFICACIONES
// ============================================================

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating    Int      // 1-5
  comment   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ============================================================
// CUPONES DE DESCUENTO
// ============================================================

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Int       @default(10) // Porcentaje de descuento (ej: 10 = 10%)
  assignedEmail      String    // Email al que está vinculado el cupón
  isUsed             Boolean   @default(false)
  usedAt             DateTime?
  usedByOrderId      String?   // ID de la orden que lo redimió

  createdAt          DateTime  @default(now())

  @@index([code])
  @@index([assignedEmail])
  @@map("coupons")
}

// ============================================================
// LOGS Y SEGURIDAD (Webhooks)
// ============================================================

model WebhookLog {
  id           String   @id @default(cuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])

  provider     String   // "BOLD", "ADDI"
  eventType    String?  // "payment.approved", etc.
  payload      Json     // Respuesta completa JSON
  signature    String?  // Para validar seguridad
  
  status       Int      // Código HTTP respuesta (200, 400, etc)
  errorMessage String?
  attempt      Int      @default(1)

  createdAt    DateTime @default(now())

  @@index([orderId])
  @@map("webhook_logs")
}

// ============================================================
// NOTIFICACIONES ADMIN
// ============================================================

model AdminNotification {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  title     String
  body      String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}