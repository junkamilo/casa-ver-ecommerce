generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")        // Pooler de Neon (puerto 6543)
  directUrl    = env("DIRECT_URL")          // Conexión directa para migrations (puerto 5432)

  // PRODUCCIÓN: DATABASE_URL debe incluir estos parámetros para soportar 50+ usuarios simultáneos:
  //   ?pgbouncer=true&connection_limit=1
  // Ejemplo: postgresql://user:pass@ep-xxx.neon.tech:6543/neondb?pgbouncer=true&connection_limit=1
  // Sin estos parámetros, Neon agota las conexiones bajo carga y las transacciones fallan.
}

// ============================================================
// ENUMS (Configuración Global)
// ============================================================

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  ONESIZE
}

enum OrderStatus {
  PENDING     // Creada, esperando pago
  PROCESSING  // Webhook recibido, validando el pago
  PAID        // Pago confirmado (la logística posterior la lleva el POS)
  SHIPPED     // Legado: el envío lo registra el POS (fulfillmentStatus)
  DELIVERED   // Legado: la entrega la registra el POS (fulfillmentStatus)
  CANCELLED   // Cancelada
  FAILED      // Pago fallido
  REFUNDED    // Reembolsado por Bold (VOID_APPROVED)
}

enum PaymentMethod {
  BOLD
  ADDI
  NEQUI
  BANCOLOMBIA
  DAVIPLATA
}

enum ReviewStatus {
  PENDING    // Esperando moderación del admin
  APPROVED   // Visible en la tienda
  REJECTED   // Rechazada por el admin
}


// ============================================================
// CATEGORÍAS, SUBCATEGORÍAS Y TIPOS DE PRENDA → viven en el POS
// ============================================================
// La tienda los lee de la API pública del POS (árbol de categorías y /garment-types); no se guardan
// aquí. Las tablas antiguas quedaron como _legacy_* (migración 20261022000000_categories_from_pos).

// ============================================================
// AUTENTICACIÓN & USUARIOS (NextAuth + Perfil Cliente)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Clientes de la tienda (los administradores viven en el POS: platform.users con web_admin).
  password      String?
  phone         String?
  cedula        String?
  recoveryEmail String?

  // Relaciones
  accounts              Account[]
  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  verificationTokens    EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  cart                  Cart?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([expires])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([expires])
  @@map("password_reset_tokens")
}

// Registro pendiente de verificación — el usuario NO existe en `users` todavía.
// Se crea al solicitar registro y se elimina al verificar el correo exitosamente.
model PendingRegistration {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String
  phone         String?
  recoveryEmail String?
  codeHash      String
  expires       DateTime
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([expires])
  @@map("pending_registrations")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String
  cedula        String?
  phone         String
  department    String
  city          String
  address       String
  addressDetail String?
  zipCode       String?
  isDefault     Boolean  @default(false)

  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// PEDIDOS & PAGOS
// Productos, variantes e inventario viven en el POS (la web lee su API pública y reserva el stock allí
// mientras el cliente paga). Las tablas de catálogo de Neon quedaron en el esquema legacy_catalog.
// ============================================================

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique // Secuencial amigable "ORD-001"
  
  userId             String
  user               User          @relation(fields: [userId], references: [id])

  // Snapshot de Dirección (Para que no cambie si el usuario edita su perfil)
  addressId          String?
  address            Address?      @relation(fields: [addressId], references: [id])
  shippingName       String
  shippingAddress    String
  shippingCity       String
  shippingDepartment String
  shippingPhone      String
  shippingCedula     String?
  shippingZone       String?       // "REGIONAL" | "ISLANDS" | "NATIONAL" — snapshot
  shippingRateName   String?       // "Metropolitana Bucaramanga" — foto del momento de compra

  // Montos
  subtotal                  Decimal       @db.Decimal(10, 2)                          // Suma de ítems a precios reales de BD
  shippingCost              Decimal       @db.Decimal(10, 2) @default(0)              // Calculado server-side: $11.000 Santander / $18.000 resto
  discount                  Decimal       @db.Decimal(10, 2) @default(0)              // couponDiscount
  total                     Decimal       @db.Decimal(10, 2)                          // subtotal + shippingCost - discount

  // Estado y Pago
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  
  // Bold / Addi Integración
  transactionId      String?       @unique // UUID idempotente enviado a pasarela
  boldLinkId         String?       // LNK_* retornado por Bold al crear el link de pago
  paymentId          String?       // transaction_id retornado por Bold en el webhook al aprobar
  paymentExpiresAt   DateTime?     // UTC — ventana de gracia para completar pago (snapshot cupón)

  // Logística (estado, guía, envío y entrega): vive en el POS (Tienda → Pedidos) y se lee de
  // GET /api/public/orders. La web solo guarda el pago: status = PENDING | PAID | FAILED | CANCELLED | REFUNDED.

  items              OrderItem[]
  webhookLogs        WebhookLog[]
  notifications      AdminNotification[]
  reviews            Review[]

  // Cupón del POS aplicado (snapshot): el POS lo validó y calculó el descuento al crear la orden.
  couponCode          String?       // código que escribió el cliente (normalizado)
  posPromotionId      String?       // promotionId del POS (PRM-año-número); nulo en cupones viejos de la web
  couponDiscountType  String?       // PERCENTAGE | FIXED
  couponDiscountValue Int?          // % entero o pesos enteros

  paidAt             DateTime?
  cancelledAt        DateTime?

  // Email tracking
  confirmationEmailSentAt       DateTime?
  confirmationEmailFailedAt     DateTime?
  confirmationEmailError        String?
  abandonedCheckoutEmailSentAt  DateTime?
  reviewRequestEmailSentAt      DateTime? // Solicitud de reseña (7 días post-entrega)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String // Referencia al producto (sin FK para soportar sets)
  variantId   String // SKU del POS (pos-<slug>-<colorId>-<sizeId>); pedidos viejos: id de Neon

  // Snapshot del ítem (Nombre, precio, etc. congelados al momento de compra)
  name        String
  sku         String
  colorName   String
  size        Size
  price       Decimal        @db.Decimal(10, 2)
  quantity    Int
  total       Decimal        @db.Decimal(10, 2)
  couponDiscount Decimal     @db.Decimal(10, 2) @default(0) // parte del descuento del cupón en esta línea (la calcula el POS)
  imageUrl    String?        // Foto principal de la variante

  @@map("order_items")
}

// ============================================================
// CARRITO (Server-side para usuarios autenticados)
// ============================================================

model Cart {
  id                    String     @id @default(cuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 CartItem[]
  abandonedEmailSentAt  DateTime?
  updatedAt             DateTime   @updatedAt
  createdAt             DateTime   @default(now())

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  variantId String
  sku       String
  name      String
  price     Decimal @db.Decimal(10, 2)
  imageUrl  String?
  color     String
  size      String
  quantity  Int

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ============================================================
// RESEÑAS & CALIFICACIONES
// ============================================================

/// Lo que la web decide sobre un producto del POS (por slug, sin FK: el producto vive en el POS).
/// Es lo único del catálogo del POS que se guarda aquí; el resto se lee de la API del POS.
model ProductWebSettings {
  slug            String    @id
  metaTitle       String?
  metaDescription String?
  coverImageUrl   String?   // portada elegida en la web (si ya no es foto del producto, se ignora)
  videoUrl        String?   // video propio de la web (fuera de los medios del POS)
  isNew           Boolean   @default(false) // "Nueva colección" (bandera solo de la web)
  isOnSale        Boolean   @default(false) // oferta manual; la etiqueta ON_SALE del POS manda sobre ella
  isOnSaleAt      DateTime?
  publishedAt     DateTime  @default(now()) // alta en la tienda: orden de los listados (el POS no la envía)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
  @@map("product_web_settings")
}

model Review {
  id          String   @id @default(cuid())
  // Producto por su slug (URL /product/<slug>): el mismo en el POS y en la web. Sin FK: los productos
  // del POS no se guardan en esta base cuando el catálogo deja de copiarse.
  productSlug String
  productName String?  // nombre al momento de la reseña (admin, enlace de reseña)
  productId   String?  // legacy: id de Neon de reseñas anteriores

  // Usuario registrado (null si es invitado)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Invitado (null si es usuario registrado)
  guestName String?

  // Compra verificada: obligatorio para enviar reseña
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  rating    Int      // 1-5
  comment   String   @db.Text

  // Moderación
  status    ReviewStatus @default(PENDING)

  // Token de enlace mágico (enviado por email post-entrega)
  reviewToken          String?   @unique
  reviewTokenUsed      Boolean   @default(false)
  reviewTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productSlug]) // Una reseña por producto por orden
  @@index([productSlug])
  @@index([status])
  @@map("reviews")
}

// ============================================================
// VIGENCIA (popups de publicidad)
// Los cupones viven en el POS (sales.promotions): la web los valida con POST /api/public/promotions/validate.
// Las tablas coupons, coupon_batches y coupon_usages quedaron como _legacy_* (20261026000000_coupons_from_pos).
// ============================================================

enum CouponScheduleMode {
  NONE
  SINGLE_DAY
  DATE_RANGE
}

// ============================================================
// PUBLICIDAD — POPUPS PROMOCIONALES
// ============================================================

enum PromoPopupPlacement {
  HOME
  PRODUCT
  CHECKOUT
}

model PromoPopup {
  id           String              @id @default(cuid())
  name         String
  placement    PromoPopupPlacement
  isActive     Boolean             @default(false)

  headline     String
  subtitle     String
  couponCode   String
  disclaimer   String
  ctaText      String
  ctaUrl       String              @default("/tienda")

  delaySeconds Int                 @default(3)
  scheduleMode CouponScheduleMode  @default(NONE)
  validFrom    DateTime?
  validTo      DateTime?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([placement, isActive])
  @@map("promo_popups")
}

// ============================================================
// LOGS Y SEGURIDAD (Webhooks)
// ============================================================

model WebhookLog {
  id           String   @id @default(cuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])

  provider     String   // "BOLD", "ADDI"
  eventType    String?  // "payment.approved", etc.
  payload      Json     // Respuesta completa JSON
  signature    String?  // Para validar seguridad
  
  status       Int      // Código HTTP respuesta (200, 400, etc)
  errorMessage String?
  attempt      Int      @default(1)

  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("webhook_logs")
}

// Avisos de cambios de catálogo recibidos del POS (idempotencia por eventId)
model PosWebhookEvent {
  id           String    @id @default(cuid())
  eventId      String    @unique
  event        String    // "product.upserted", "category.removed", ...
  entityType   String    // "category" | "subcategory" | "product"
  entityId     String    // webId (categorías) o slug (productos)
  action       String    // "upserted" | "removed" | "stock_changed"
  status       String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  attempts     Int       @default(0)
  errorMessage String?
  occurredAt   DateTime?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

  @@index([status])
  @@index([receivedAt])
  @@map("pos_webhook_events")
}

// ============================================================
// NOTIFICACIONES ADMIN
// ============================================================

model AdminNotification {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  title     String
  body      String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}

// Colores: la tienda usa la paleta del POS (GET /api/public/catalog/colors). La tabla "colors" se
// renombró a "_legacy_colors" (migración 20261024000000_colors_from_pos) y ya no tiene modelo.

// ============================================================
// HERO / BANNER PRINCIPAL
// ============================================================

model HeroSlide {
  id             String   @id @default(cuid())
  position       Int      @unique          // orden de aparición en el slider
  mediaUrl       String   @default("")     // Desktop / arte principal (Bunny CDN)
  mediaUrlMobile String?                   // Art-direction mobile (opcional)
  mediaUrlTablet String?                   // Art-direction tablet (opcional)
  posterUrl      String?                   // Optional legacy poster for video slides
  mediaType      String   @default("image") // "image" | "video"
  headline       String?                   // Texto principal (opcional)
  subheadline    String?                   // Subtítulo (opcional)
  /// { mobile/tablet/desktop: { x, y, zoom } } — object-position 0–100 por dispositivo
  mediaFocus     Json?
  /// Si true y mediaType=video, el carrusel espera a que termine el video
  playFullVideo  Boolean  @default(false)
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@index([position])
  @@map("hero_slides")
}

/// Singleton (id=1) — duración global del carrusel hero
model HeroSettings {
  id              Int      @id @default(1)
  slideDurationMs Int      @default(6000)
  updatedAt       DateTime @updatedAt

  @@map("hero_settings")
}

// ============================================================
// ENVÍOS Y CATÁLOGO GEOGRÁFICO: viven en el POS (shipping.rates, shipping.config, core.countries,
// core.departments, core.municipalities). La web cotiza con GET /api/public/shipping/quote y llena los
// selectores de dirección con GET /api/public/geography/** (20261028000000_shipping_from_pos).
// ============================================================
